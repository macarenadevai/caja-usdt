# Caja — environment variables (NUNCA commitees este archivo)

# Passphrase de la wallet WDK (necesaria para unlock del daemon)
WDK_PASSPHRASE=

# API key de DeepSeek para el agente AI (function calling)
DEEPSEEK_API_KEY=

# Puerto del backend
PORT=8788

# Red y token por defecto (demo en Sepolia con USDT mock)
NETWORK=sepolia
DEFAULT_TOKEN=usdt

# Nombre de la wallet de la caja en el WDK CLI
CAJA_WALLET=caja
